# MongoDB (optional — only if model scripts need DB)
DATABASE_URL=

# development | production — pipeline routes off in production unless ALLOW_PIPELINE_ROUTES=true
MODEL_API_ENV=production

# Browser origins (comma-separated). Empty disables CORS middleware.
# CORS_ORIGINS=https://painpal-web.vercel.app

# Uvicorn (local only: python main.py)
MODEL_SERVER_HOST=0.0.0.0
MODEL_SERVER_PORT=8000

# Max MRI upload size in bytes (default 10 MB)
# MRI_MAX_UPLOAD_BYTES=10485760

# --- Vercel: host all ML on painpal-model (no Render/Railway proxy) ---
# 1) Train locally, export ONNX: cd model/image && python export_onnx.py
# 2) Upload: BLOB_READ_WRITE_TOKEN=... python scripts/publish_vercel_artifacts.py
# 3) Paste printed MODEL_ARTIFACTS_JSON here (single line JSON)
MODEL_ARTIFACTS_JSON=
MODEL_USE_ONNX=true
MODEL_ARTIFACTS_DIR=/tmp/painpal-artifacts
# MODEL_ARTIFACT_DOWNLOAD_TIMEOUT=120

# Per-file URLs (optional if using MODEL_ARTIFACTS_JSON)
# MODEL_ARTIFACT_XGBOOST_URL=
# MODEL_ARTIFACT_LABEL_ENCODER_URL=
# MODEL_ARTIFACT_NEXT_ATTACK_URL=
# MODEL_ARTIFACT_MRI_ONNX_URL=

# Compact next-attack for Vercel (retrain before upload):
# NEXT_ATTACK_N_EST_REG=50 NEXT_ATTACK_N_EST_BIN=50 NEXT_ATTACK_N_EST_TYPE=80 python text/train_next_attack.py
