# Uvicorn bind when running: python main.py
MODEL_SERVER_HOST=0.0.0.0
MODEL_SERVER_PORT=8000

# development | production — in production, POST /pipeline/* is disabled unless ALLOW_PIPELINE_ROUTES=true
MODEL_API_ENV=development

# Set true only if you need remote training triggers in production (default off when MODEL_API_ENV=production)
# ALLOW_PIPELINE_ROUTES=false

# Comma-separated browser origins allowed to call this API (Next.js dev server, deployed app, etc.). Empty = no CORS middleware.
# CORS_ORIGINS=http://127.0.0.1:3000,http://localhost:3000

# Next.js server env (client/.env) — base URL of this FastAPI service, no trailing slash:
# MODEL_API_URL=http://127.0.0.1:8000

# Logging (stderr): app logger name migraine_model_api
# MODEL_API_LOG_LEVEL=INFO
# MODEL_API_LOG_FORMAT=%(asctime)s %(levelname)s [%(name)s] %(message)s
# MODEL_API_HTTP_LOG=true
# MODEL_API_LOG_SKIP_HEALTH=true
# MODEL_API_ACCESS_LOG=false
