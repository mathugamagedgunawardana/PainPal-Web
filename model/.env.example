# MongoDB connection string (same database as Next.js client when applicable)
DATABASE_URL=

# Google API key (if used by model scripts / live agent)
GOOGLE_API_KEY=

# Uvicorn (python main.py)
MODEL_SERVER_HOST=0.0.0.0
MODEL_SERVER_PORT=8000 

# development | production — pipeline routes off in production unless ALLOW_PIPELINE_ROUTES=true
MODEL_API_ENV=development

# Browser origins allowed to call this API (comma-separated). Empty disables CORS middleware.
CORS_ORIGINS=

# Uncomment to force pipeline endpoints on/off regardless of MODEL_API_ENV
# ALLOW_PIPELINE_ROUTES=true

# Logging (stderr): app logger name migraine_model_api
# MODEL_API_LOG_LEVEL=INFO
# MODEL_API_LOG_FORMAT=%(asctime)s %(levelname)s [%(name)s] %(message)s
# MODEL_API_HTTP_LOG=true
# MODEL_API_LOG_SKIP_HEALTH=true
# MODEL_API_ACCESS_LOG=false

# Vercel lightweight API only: proxy prediction routes to the real model host.
# Example: MODEL_UPSTREAM_URL=https://your-render-model.onrender.com
# MODEL_UPSTREAM_TIMEOUT=60
