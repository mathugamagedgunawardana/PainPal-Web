DATABASE_URL=

# Required on Vercel and any NODE_ENV=production host: random string, min 32 characters.
# If unset or too short, POST /api/auth/login returns 500 with "JWT_SECRET must be set..." in server logs.
# Generate locally: openssl rand -base64 32
JWT_SECRET=

# Python migraine FastAPI (model/main.py) on Railway/Render/Fly — public URL, no trailing slash.
# Do NOT use localhost on Vercel. Avoid the Vercel model shim unless MODEL_UPSTREAM_URL points to full main.py.
# Example: https://your-model-service.example.com
MODEL_API_URL=

# Login-time batch seed sync (500 events → /predict). Off in production unless explicitly enabled.
# ENABLE_SEED_MODEL_SYNC=true

# Vercel Blob — required for local MRI uploads / npm run seed:mri-blob
# If the store is already connected to your Next.js project on Vercel, you do NOT create this
# manually on the Storage page. Vercel adds it to the *project* automatically:
#   1. vercel.com → your Next.js project → Settings → Environment Variables
#   2. Find BLOB_READ_WRITE_TOKEN → click the eye icon → copy the value
#   3. Paste below (starts with vercel_blob_rw_…, long string — NOT "MODEL_…")
# Or pull all env vars locally:
#   cd client && npx vercel link && npx vercel env pull .env.local
# Then copy BLOB_READ_WRITE_TOKEN from .env.local into .env
BLOB_READ_WRITE_TOKEN=

# Optional: richer patient AI summaries via OpenAI (otherwise rule-based text from episode aggregates)
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
