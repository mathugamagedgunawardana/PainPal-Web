// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// 1. Define the datasource (MongoDB)
datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// 2. Define the generator
generator client {
  provider = "prisma-client-js"
}


// ----------------------------------------------
// CORE AUTHENTICATION & PROFILE MODELS
// ----------------------------------------------

// Central User model for authentication
model User {
  id              String           @id @default(auto()) @map("_id") @db.ObjectId
  email           String           @unique
  passwordHash    String
  role            Role
  createdAt       DateTime         @default(now())
  googleId        String?          @unique
  googleEmail     String?
  googleRefreshToken String?
  
  // Relations
  patientProfile  PatientProfile?
  doctorProfile   DoctorProfile?
}

model DoctorProfile {
  id              String           @id @default(auto()) @map("_id") @db.ObjectId
  userId          String           @unique @db.ObjectId
  user            User             @relation(fields: [userId], references: [id])
  name            String
  specialization  String
  
  clinicId        String           @db.ObjectId
  clinic          Clinic           @relation(fields: [clinicId], references: [id])
  
  // Relations
  patientLinks    PatientDoctorLink[]
  summaries       DoctorPatientSummary[] @relation("doctorSummaries")
  medicationGroups MedicationGroup[]
  appointments    Appointment[]
  clinicalNotes   ClinicalNote[]
  communications  Communication[]
  conversations   Conversation[]
}

model Clinic {
  id                String          @id @default(auto()) @map("_id") @db.ObjectId
  name              String
  address           String
  ehrSystemEndpoint String?         // For EHR integration 
  
  // Relations
  doctors           DoctorProfile[]
}

model PatientProfile {
  id            String           @id @default(auto()) @map("_id") @db.ObjectId
  userId        String           @unique @db.ObjectId
  user          User             @relation(fields: [userId], references: [id])
  name          String
  dob           DateTime
  gender        String?          // 'Male', 'Female', 'Other'
  phone         String?
  email         String?
  address       String?
  condition     String?          // e.g., "Chronic Migraine with Aura"
  ehrRecordId   String?          // For EHR integration 
  createdAt     DateTime         @default(now())
  
  // Relations
  doctorLinks     PatientDoctorLink[]
  migraineEvents  MigraineEvent[]
  medicationLogs  MedicationLog[]
  medicationGroups MedicationGroup[]
  summaries       DoctorPatientSummary[] @relation("patientSummaries")
  insights        AIDiagnosticInsight[]
  appointments    Appointment[]
  clinicalNotes   ClinicalNote[]
  communications  Communication[]
  conversations   Conversation[]
}

// ----------------------------------------------
// LINKING & DATA MODELS (Doctor-Facing)
// ----------------------------------------------

// Explicit many-to-many relationship table
model PatientDoctorLink {
  id          String      @id @default(auto()) @map("_id") @db.ObjectId
  doctorId    String      @db.ObjectId
  doctor      DoctorProfile @relation(fields: [doctorId], references: [id])
  
  patientId   String      @db.ObjectId
  patient     PatientProfile @relation(fields: [patientId], references: [id])
  
  linkStatus  LinkStatus
  createdAt   DateTime    @default(now())

  @@unique([doctorId, patientId]) // Ensure link only exists once
}

// Patient-logged event, viewable by doctor
model MigraineEvent {
  id                 String         @id @default(auto()) @map("_id") @db.ObjectId
  patientId          String         @db.ObjectId
  patient            PatientProfile @relation(fields: [patientId], references: [id])
  
  startDatetime      DateTime
  severity           Int            // 1-10 scale
  duration           String?        // e.g., "6 hours", "4 hours"
  symptomsLog        String         // Could be JSON string for detailed symptoms
  detectedSymptoms   String[]       // Normalized symptom labels used by model/rules (e.g., ["Photophobia", "Vertigo"])
  migraineType       MigraineTypeClassification? // Clinician/model migraine type for this event
  migraineTypeConfidence Float?     // 0-100 confidence for migraineType
  perceivedTriggers  String?        // Patient-reported triggers (comma-separated or JSON)
  
  // Medication Group & Effectiveness Tracking
  medicationGroupId  String?        @db.ObjectId
  medicationGroup    MedicationGroup? @relation(fields: [medicationGroupId], references: [id])
  effectiveness      MedicationEffectiveness? // How effective the medication was
  
  createdAt          DateTime       @default(now())
}

// Patient-logged medication, viewable by doctor
model MedicationLog {
  id                 String          @id @default(auto()) @map("_id") @db.ObjectId
  patientId          String          @db.ObjectId
  patient            PatientProfile  @relation(fields: [patientId], references: [id])
  
  medicationGroupId  String?         @db.ObjectId
  medicationGroup    MedicationGroup? @relation(fields: [medicationGroupId], references: [id])
  
  medicationName     String
  medicationType     MedicationType  // PREVENTIVE, RESCUE
  datetimeTaken      DateTime
  dosage             String
  frequency          String?         // e.g., "Daily", "As needed"
  adherenceRate      Float?          // Percentage: 0-100
  createdAt          DateTime        @default(now())
}

// ----------------------------------------------
// AI-GENERATED DOCTOR SUPPORT MODELS
// ----------------------------------------------

// Structured summaries for the doctor dashboard 
model DoctorPatientSummary {
  id                        String         @id @default(auto()) @map("_id") @db.ObjectId
  patientId                 String         @db.ObjectId
  patient                   PatientProfile @relation(fields: [patientId], references: [id], name: "patientSummaries")
  
  doctorId                  String         @db.ObjectId
  doctor                    DoctorProfile  @relation(fields: [doctorId], references: [id], name: "doctorSummaries")
  
  generatedDate             DateTime       @default(now())
  summaryType               SummaryType    // e.g., 'WEEKLY'
  structuredSummaryText     String
  avgFrequency              Float
  avgSeverity               Float
  adherenceScore            Float          // 
  treatmentOutcomeAnalysis  String
  
  @@unique([patientId, doctorId, generatedDate])
}

// AI-generated insights and alerts 
model AIDiagnosticInsight {
  id                     String         @id @default(auto()) @map("_id") @db.ObjectId
  patientId              String         @db.ObjectId
  patient                PatientProfile @relation(fields: [patientId], references: [id])
  
  createdDatetime        DateTime       @default(now())
  migraineType           MigraineTypeClassification? // Predicted migraine subtype
  migraineTypeConfidence Float?         // 0-100 confidence score for migraine type
  diagnosticProbability  Float?         // 
  riskAlertLevel         RiskAlertLevel // 
  keyContributors        String[]       // e.g., ["Weather", "Sleep", "Stress"]
  detectedSymptoms       String[]       // Structured symptoms used by inference pipeline
  modelName              String?        // e.g., "xgboost"
  modelVersion           String?        // e.g., "xgb-v1.2.0"
} 

// Doctor appointment with patient
model Appointment {
  id               String          @id @default(auto()) @map("_id") @db.ObjectId
  patientId        String          @db.ObjectId
  patient          PatientProfile  @relation(fields: [patientId], references: [id])
  
  doctorId         String          @db.ObjectId
  doctor           DoctorProfile   @relation(fields: [doctorId], references: [id])
  
  appointmentDate  DateTime
  appointmentType  String          // e.g., "Follow-up", "Regular Check-up", "Initial Consultation"
  status           AppointmentStatus  // SCHEDULED, COMPLETED, CANCELLED
  notes            String?
  createdAt        DateTime        @default(now())
}

// Clinical notes written by doctors
model ClinicalNote {
  id               String          @id @default(auto()) @map("_id") @db.ObjectId
  patientId        String          @db.ObjectId
  patient          PatientProfile  @relation(fields: [patientId], references: [id])
  
  doctorId         String          @db.ObjectId
  doctor           DoctorProfile   @relation(fields: [doctorId], references: [id])
  
  noteContent      String          // The actual note text
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
}

// Communication log between doctor and patient
model Communication {
  id               String          @id @default(auto()) @map("_id") @db.ObjectId
  patientId        String          @db.ObjectId
  patient          PatientProfile  @relation(fields: [patientId], references: [id])
  
  doctorId         String?         @db.ObjectId
  doctor           DoctorProfile?  @relation(fields: [doctorId], references: [id])
  
  communicationType String         // e.g., "Reminder", "Message", "Alert"
  message          String
  channel          String          // e.g., "SMS", "Email", "In-App"
  createdAt        DateTime        @default(now())
}

// ----------------------------------------------
// CHAT (Doctor–Patient messaging)
// ----------------------------------------------

model Conversation {
  id        String        @id @default(auto()) @map("_id") @db.ObjectId
  doctorId  String        @db.ObjectId
  doctor    DoctorProfile @relation(fields: [doctorId], references: [id])
  patientId String        @db.ObjectId
  patient   PatientProfile @relation(fields: [patientId], references: [id])
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  messages  ChatMessage[]

  @@unique([doctorId, patientId])
}

model ChatMessage {
  id             String             @id @default(auto()) @map("_id") @db.ObjectId
  conversationId String             @db.ObjectId
  conversation   Conversation       @relation(fields: [conversationId], references: [id])
  senderRole     ChatSenderRole     // DOCTOR or PATIENT
  senderUserId   String             @db.ObjectId // User.id for audit
  content        String
  createdAt      DateTime           @default(now())
  readAt         DateTime?          // When the other party read it (optional)
}

// Medication Group - Protocol of multiple medications prescribed together
model MedicationGroup {
  id                String           @id @default(auto()) @map("_id") @db.ObjectId
  patientId         String           @db.ObjectId
  patient           PatientProfile   @relation(fields: [patientId], references: [id])
  
  doctorId          String           @db.ObjectId
  doctor            DoctorProfile    @relation(fields: [doctorId], references: [id])
  
  name              String           // e.g., "Acute Treatment Protocol"
  description       String?          // Optional description
  groupType         MedicationType   // PREVENTIVE or RESCUE
  medications       String[]         // Array of medication names
  color             String?          // For UI display (e.g., "blue", "purple")
  
  isActive          Boolean          @default(true)
  adherenceRate     Float?           // Overall adherence for the group (0-100)
  
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  
  // Relations
  migraineEvents    MigraineEvent[]
  medicationLogs    MedicationLog[]
}


// ----------------------------------------------
// ENUMERATIONS
// ----------------------------------------------

enum Role {
  ADMIN
  PATIENT
  DOCTOR
}

enum LinkStatus {
  PENDING
  ACTIVE
  REVOKED
}

enum MedicationType {
  PREVENTIVE
  RESCUE
}

enum SummaryType {
  WEEKLY
  MONTHLY
}

enum RiskAlertLevel {
  NONE
  MEDIUM
  HIGH
}

enum AppointmentStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

enum MedicationEffectiveness {
  LOW
  MODERATE
  HIGH
}

enum ChatSenderRole {
  DOCTOR
  PATIENT
}

enum MigraineTypeClassification {
  MIGRAINE_WITHOUT_AURA
  MIGRAINE_WITH_AURA
  BRAINSTEM_AURA_MIGRAINE
  HEMIPLEGIC_MIGRAINE
  RETINAL_MIGRAINE
  CHRONIC_MIGRAINE
  MENSTRUAL_MIGRAINE
  VESTIBULAR_MIGRAINE
  STATUS_MIGRAINOSUS
  PROBABLE_MIGRAINE
}